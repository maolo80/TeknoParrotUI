diff --git a/TeknoParrotUi/Helpers/BindingFocus.cs b/TeknoParrotUi/Helpers/BindingFocus.cs
new file mode 100644
index 0000000..3eddd3f
--- /dev/null
+++ b/TeknoParrotUi/Helpers/BindingFocus.cs
@@ -0,0 +1,17 @@
+﻿using System.Linq;
+using System.Windows;
+
+namespace TeknoParrotUi.Helpers
+{
+    public static class BindingFocus
+    {
+        /// <summary>
+        /// Window whose focused text box receives a pressed binding. Windows[0] is
+        /// not always the main window: debugger tooling and first-run dialogs can
+        /// come first, and then every press was dropped.
+        /// </summary>
+        public static Window Window =>
+            Application.Current.Windows.OfType<Window>().FirstOrDefault(w => w.IsActive) ??
+            Application.Current.MainWindow;
+    }
+}
diff --git a/TeknoParrotUi/Helpers/JoystickControlDirectInput.cs b/TeknoParrotUi/Helpers/JoystickControlDirectInput.cs
index 56e8891..6a61415 100644
--- a/TeknoParrotUi/Helpers/JoystickControlDirectInput.cs
+++ b/TeknoParrotUi/Helpers/JoystickControlDirectInput.cs
@@ -278,7 +278,7 @@ namespace TeknoParrotUi.Helpers
         /// <returns></returns>
         private TextBox GetActiveTextBox()
         {
-            IInputElement focusedControl = FocusManager.GetFocusedElement(Application.Current.Windows[0]);
+            IInputElement focusedControl = FocusManager.GetFocusedElement(BindingFocus.Window);
             if (focusedControl == null)
                 return null;
             if (focusedControl.GetType() == typeof(TextBox))

From fcf07d740fe18e6c0e1b0f97bc52f3fafc9f673b Mon Sep 17 00:00:00 2001
From: maolo80 <maolo80@gmail.com>
Date: Mon, 26 Oct 2026 14:51:42 +0000
Subject: [PATCH 3/3] TeknoNaomi: add Auto internal resolution

The runner reduces its raster to the window with nearest sampling, so a
render scale above the display only discards rows: 8x on a 2160p screen
looks worse than 4x. Auto picks the largest scale whose 480 source lines
fit the primary display's current mode (physical pixels, read with
EnumDisplaySettings as MonitorSelection does), from 1 to 8, and falls
back to 4 when the display is unknown. The default stays 4.

The launch log now names the render scale and whether Auto chose it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xkm42Nb8k8qCUfB5RCiVU3
---
 TeknoParrotUi.Common/TeknoNaomiLaunch.cs      | 59 ++++++++++++++++++-
 .../TeknoNaomiProfileSettings.cs              |  8 +++
 Tests/TeknoNaomiRelease/Program.cs            | 22 ++++++-
 3 files changed, 85 insertions(+), 4 deletions(-)

diff --git a/TeknoParrotUi.Common/TeknoNaomiLaunch.cs b/TeknoParrotUi.Common/TeknoNaomiLaunch.cs
index 4aaa7e5..c55d18a 100644
--- a/TeknoParrotUi.Common/TeknoNaomiLaunch.cs
+++ b/TeknoParrotUi.Common/TeknoNaomiLaunch.cs
@@ -4,6 +4,7 @@ using System.Diagnostics;
 using System.Globalization;
 using System.IO;
 using System.Linq;
+using System.Runtime.InteropServices;
 using System.Text;
 
 namespace TeknoParrotUi.Common
@@ -17,12 +18,25 @@ namespace TeknoParrotUi.Common
         public string Cabinet { get; internal set; }
         public string BindingsPath { get; internal set; }
         public string BindingsText { get; internal set; }
+        public int RenderScale { get; internal set; }
+        public bool AutoRenderScale { get; internal set; }
         public ProcessStartInfo StartInfo { get; internal set; }
     }
 
     // Plans are device-free. Prepare writes only a newly named launch binding file.
     public static class TeknoNaomiLaunch
     {
+        public const string AutoResolution = "Auto";
+
+        // Height in physical pixels of the primary display; 0 when unknown. Tests replace it.
+        public static Func<int> DisplayHeight { get; set; } = PrimaryDisplayHeight;
+
+        // The runner reduces its raster to the window with nearest sampling, so a
+        // scale above the display only discards rows. Pick the largest scale whose
+        // 480 source lines still fit the display height.
+        public static int AutoRenderScale(int displayHeight) =>
+            displayHeight <= 0 ? 4 : Math.Max(1, Math.Min(8, displayHeight / 480));
+
         public static TeknoNaomiLaunchPlan Plan(GameProfile profile, string uiRoot,
             string gameLocation, bool isTest = false)
         {
@@ -81,8 +95,12 @@ namespace TeknoParrotUi.Common
             var configuredStateRoot = Setting("Save Root");
             var state = Resolve(string.IsNullOrWhiteSpace(configuredStateRoot) ? Path.Combine(work, "state") : configuredStateRoot);
             var cabinet = TeknoNaomiProfileSettings.CabinetStateId(profile);
-            if (!int.TryParse(Setting("Internal Resolution", "4"), NumberStyles.None, CultureInfo.InvariantCulture, out var scale) || scale < 1 || scale > 8)
-                throw new InvalidOperationException("Internal Resolution must be from 1 to 8.");
+            var resolution = Setting("Internal Resolution", "4");
+            var autoScale = resolution == AutoResolution;
+            int scale;
+            if (autoScale) scale = AutoRenderScale(DisplayHeight?.Invoke() ?? 0);
+            else if (!int.TryParse(resolution, NumberStyles.None, CultureInfo.InvariantCulture, out scale) || scale < 1 || scale > 8)
+                throw new InvalidOperationException("Internal Resolution must be Auto or from 1 to 8.");
             var display = Setting("DisplayMode", "Windowed");
             if (display != "Windowed" && display != "Fullscreen") throw new InvalidOperationException("Invalid DisplayMode.");
             var bindings = TeknoNaomiInputBindings.Serialize(profile, entry.Set);
@@ -124,6 +142,7 @@ namespace TeknoParrotUi.Common
             else if (Enabled("Side-by-Side 3D")) args.Add("--sbs");
             return new TeknoNaomiLaunchPlan { Set = entry.Set, RomArchive = archive, ChdRoot = chdRoot,
                 StateRoot = state, Cabinet = cabinet, BindingsPath = bindingPath, BindingsText = bindings,
+                RenderScale = scale, AutoRenderScale = autoScale,
                 StartInfo = new ProcessStartInfo(Path.Combine(work, "TeknoNaomi.exe"), string.Join(" ", args.Select(Quote)))
                 { UseShellExecute = false, CreateNoWindow = true, WorkingDirectory = work, RedirectStandardError = true } };
         }
@@ -138,10 +157,44 @@ namespace TeknoParrotUi.Common
             Directory.CreateDirectory(Path.GetDirectoryName(plan.BindingsPath));
             using (var file = new FileStream(plan.BindingsPath, FileMode.CreateNew, FileAccess.Write, FileShare.Read))
             using (var writer = new StreamWriter(file, new UTF8Encoding(false, true))) writer.Write(plan.BindingsText);
-            log?.Invoke("TeknoNaomi: " + plan.Set + ", cabinet " + plan.Cabinet + ". Saved bindings exported for this launch.");
+            log?.Invoke("TeknoNaomi: " + plan.Set + ", cabinet " + plan.Cabinet + ", render scale " + plan.RenderScale +
+                (plan.AutoRenderScale ? " (Auto)" : "") + ". Saved bindings exported for this launch.");
             return plan.StartInfo;
         }
 
+        private static int PrimaryDisplayHeight()
+        {
+            try
+            {
+                var mode = new DisplayMode { dmSize = (short)Marshal.SizeOf(typeof(DisplayMode)) };
+                return EnumDisplaySettings(null, EnumCurrentSettings, ref mode) ? mode.dmPelsHeight : 0;
+            }
+            catch (Exception error) when (error is DllNotFoundException || error is EntryPointNotFoundException)
+            {
+                return 0;
+            }
+        }
+
+        private const int EnumCurrentSettings = -1;
+
+        [DllImport("user32.dll", CharSet = CharSet.Auto)]
+        private static extern bool EnumDisplaySettings(string deviceName, int modeNumber, ref DisplayMode mode);
+
+        // DEVMODE, as in MonitorSelection. The current mode is in physical pixels,
+        // unaffected by Windows display scaling.
+        [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Auto)]
+        private struct DisplayMode
+        {
+            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmDeviceName;
+            public short dmSpecVersion, dmDriverVersion, dmSize, dmDriverExtra;
+            public int dmFields, dmPositionX, dmPositionY, dmDisplayOrientation, dmDisplayFixedOutput;
+            public short dmColor, dmDuplex, dmYResolution, dmTTOption, dmCollate;
+            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)] public string dmFormName;
+            public short dmLogPixels;
+            public int dmBitsPerPel, dmPelsWidth, dmPelsHeight, dmDisplayFlags, dmDisplayFrequency;
+            public int dmICMMethod, dmICMIntent, dmMediaType, dmDitherType, dmReserved1, dmReserved2, dmPanningWidth, dmPanningHeight;
+        }
+
         private static bool SamePath(string a, string b) => string.Equals(Path.GetFullPath(a).TrimEnd('\\', '/'), Path.GetFullPath(b).TrimEnd('\\', '/'), StringComparison.OrdinalIgnoreCase);
 
         public static string Quote(string value)
diff --git a/TeknoParrotUi.Common/TeknoNaomiProfileSettings.cs b/TeknoParrotUi.Common/TeknoNaomiProfileSettings.cs
index f66d411..3cd5542 100644
--- a/TeknoParrotUi.Common/TeknoNaomiProfileSettings.cs
+++ b/TeknoParrotUi.Common/TeknoNaomiProfileSettings.cs
@@ -41,6 +41,14 @@ namespace TeknoParrotUi.Common
                 field.Hint = hint;
                 if (options.Length > 0) field.FieldOptions = options.ToList();
             }
+            var resolution = profile.ConfigValues.FirstOrDefault(f => f.FieldName == "Internal Resolution");
+            if (resolution?.FieldOptions != null)
+            {
+                if (!resolution.FieldOptions.Contains(TeknoNaomiLaunch.AutoResolution))
+                    resolution.FieldOptions.Insert(0, TeknoNaomiLaunch.AutoResolution);
+                resolution.Hint = "Auto picks the largest scale whose 480 lines fit the primary display (2 at 1080p, 3 at 1440p, 4 at 2160p). " +
+                    "Scales above the display are reduced with nearest sampling and look worse, not sharper.";
+            }
             Add("General", "Cabinet Outputs", FieldType.Bool, "1",
                 "Publish lamps, motors and force feedback to MAMEOutput clients.");
             Add("General", "Free Play", FieldType.Bool, "0", "Set the BIOS coin setting to FREE PLAY.");
diff --git a/Tests/TeknoNaomiRelease/Program.cs b/Tests/TeknoNaomiRelease/Program.cs
index 54255ee..a688f06 100644
--- a/Tests/TeknoNaomiRelease/Program.cs
+++ b/Tests/TeknoNaomiRelease/Program.cs
@@ -90,7 +90,27 @@ internal static class ReleaseChecks
         var vr = Arguments(p0);
         Require(vr.Contains("\"--vr\" \"--vr-screen-distance\" \"1.5\" \"--vr-screen-width\" \"2.4\" \"--vr-filter\" \"linear\"") &&
             vr.Contains("\"--vr-head-locked\"") && vr.Contains("\"--no-vr-controls\"") && !vr.Contains("--sbs"), "VR options");
-        foreach (var invalid in new[] { new[] { "BIOS", "-1" }, new[] { "BIOS", "x" }, new[] { "VR Screen Width", "9" }, new[] { "VR Filter", "cubic" } })
+        var resolution = p0.ConfigValues.Single(f => f.FieldName == "Internal Resolution");
+        Require(resolution.FieldOptions.Count(o => o == "Auto") == 1 && resolution.FieldOptions[0] == "Auto" && resolution.FieldValue == "4",
+            "Auto resolution is offered once without changing the default");
+        var display = TeknoNaomiLaunch.DisplayHeight;
+        try
+        {
+            Set(p0, "Internal Resolution", "Auto");
+            foreach (var pair in new[] { new[] { 2160, 4 }, new[] { 1440, 3 }, new[] { 1080, 2 }, new[] { 1200, 2 }, new[] { 720, 1 },
+                new[] { 300, 1 }, new[] { 4320, 8 }, new[] { 0, 4 } })
+            {
+                TeknoNaomiLaunch.DisplayHeight = () => pair[0];
+                var plan = TeknoNaomiLaunch.Plan(p0, root, p0.GamePath);
+                Require(plan.RenderScale == pair[1] && plan.AutoRenderScale &&
+                    plan.StartInfo.Arguments.Contains("\"--render-scale\" \"" + pair[1] + "\""), "Auto resolution for " + pair[0] + " lines");
+            }
+            TeknoNaomiLaunch.DisplayHeight = () => throw new InvalidOperationException("Display queried for a fixed scale");
+            Set(p0, "Internal Resolution", "3");
+            Require(TeknoNaomiLaunch.Plan(p0, root, p0.GamePath).RenderScale == 3, "Fixed resolution ignores the display");
+        }
+        finally { TeknoNaomiLaunch.DisplayHeight = display; }
+        foreach (var invalid in new[] { new[] { "Internal Resolution", "auto" }, new[] { "Internal Resolution", "9" }, new[] { "BIOS", "-1" }, new[] { "BIOS", "x" }, new[] { "VR Screen Width", "9" }, new[] { "VR Filter", "cubic" } })
         {
             var p = p0.Clone();
             Set(p, invalid[0], invalid[1]);

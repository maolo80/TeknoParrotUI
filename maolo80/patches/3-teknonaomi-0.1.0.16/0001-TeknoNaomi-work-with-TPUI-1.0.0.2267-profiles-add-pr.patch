+
+        private static readonly Dictionary<string, Dictionary<InputMapping, string>> Parsed =
+            new Dictionary<string, Dictionary<InputMapping, string>>(StringComparer.Ordinal);
+
+        internal static string Find(string profileName, InputMapping mapping)
+        {
+            if (profileName == null || !Routes.TryGetValue(profileName, out var text)) return null;
+            Dictionary<InputMapping, string> routes;
+            lock (Parsed)
+            {
+                if (!Parsed.TryGetValue(profileName, out routes))
+                {
+                    routes = new Dictionary<InputMapping, string>();
+                    foreach (var pair in text.Split(';'))
+                    {
+                        var parts = pair.Split('=');
+                        routes[(InputMapping)Enum.Parse(typeof(InputMapping), parts[0])] = parts[1];
+                    }
+                    Parsed[profileName] = routes;
+                }
+            }
+            return routes.TryGetValue(mapping, out var control) ? control : null;
+        }
+    }
+}
